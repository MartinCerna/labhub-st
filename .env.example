# ============================================================================
# VARIABLES DE ENTORNO — LABHUB ST (OPCIONALES EN LOCAL, RECOMENDADAS EN CLOUD)
# Puedes configurar la nube directamente desde /admin o mediante estas variables
# para hidratación automática sin estado (ej. despliegue gratuito en Vercel).
# ============================================================================

# Clave secreta para firmar cookies HTTP-Only de sesión administrativa
LABHUB_AUTH_SECRET="reemplazar_por_cadena_aleatoria_segura_64_caracteres"

# Proveedor activo de almacenamiento gratuito: LOCAL | GOOGLE_DRIVE | ONEDRIVE
LABHUB_STORAGE_PROVIDER="LOCAL"

# ----------------------------------------------------------------------------
# OPCIÓN A: GOOGLE DRIVE + SHEETS + CALENDAR (Vía Google Apps Script — $0)
# ----------------------------------------------------------------------------
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbyvaLcBQXOv4XfD5LUqhYNauu6LOEUyHkmgmSyZTDeBDtP6A75FlN1UYn0GOJy8d2ZA/exec"
GOOGLE_WEBHOOK_SECRET=""
GOOGLE_DRIVE_FOLDER_NAME="LabHub_ST_UPN"

# ----------------------------------------------------------------------------
# OPCIÓN B: MICROSOFT ONEDRIVE + EXCEL CSV + OUTLOOK (Vía Microsoft Graph — $0)
# Compatible con cuentas personales (@outlook.com) y Microsoft 365 (@upn.pe)
# ----------------------------------------------------------------------------
ONEDRIVE_TENANT_ID="common"
ONEDRIVE_CLIENT_ID=""
ONEDRIVE_CLIENT_SECRET=""
ONEDRIVE_REFRESH_TOKEN=""
ONEDRIVE_ROOT_FOLDER="LabHub_ST_UPN"

